From 2a4a412364a34eb098f759c0eeba7690c638c027 Mon Sep 17 00:00:00 2001
From: Vedant Modi <vedantmodi@gmail.com>
Date: Tue, 3 Nov 2026 20:43:25 +0000
Subject: [PATCH] Keep the map loader running through launch, and load the map
 sooner

The loader was mounted twice (dynamic() fallback, then the map's own), so its CSS
animations restarted or sat frozen while Mapbox started up. Both now share one clock.
The landing page fetches and runs the map's code while idle and on Enter, and the
root layout preconnects to api.mapbox.com.
---
 src/app/components/Landing.tsx    | 11 ++++++++++
 src/app/components/MapWrapper.tsx | 12 ++++++++++-
 src/app/components/Mark.tsx       | 35 ++++++++++++++++++++++++++++++-
 src/app/layout.tsx                |  3 +++
 4 files changed, 59 insertions(+), 2 deletions(-)

diff --git a/src/app/components/Landing.tsx b/src/app/components/Landing.tsx
index 2d0bdf6..8f9b844 100644
--- a/src/app/components/Landing.tsx
+++ b/src/app/components/Landing.tsx
@@ -6,6 +6,7 @@ import { useEffect, useState } from 'react';

 import Reveal from './Reveal';
 import SiteHeader, { openSubscribe } from './SiteHeader';
+import { preloadMap } from './MapWrapper';

 const ROWS = [0, 1, 2, 3];

@@ -66,6 +67,15 @@ export default function Landing({ photo, years, recent }: LandingProps) {

   useEffect(() => {
     router.prefetch('/map');
+    // The route prefetch above doesn't include the map itself (it loads on the client), so
+    // fetch and run its code while the visitor is still here, once the page has settled.
+    const w = window as Window & { requestIdleCallback?: (cb: () => void, o?: { timeout: number }) => number };
+    if (w.requestIdleCallback) {
+      w.requestIdleCallback(preloadMap, { timeout: 2000 });
+    } else {
+      const t = window.setTimeout(preloadMap, 1200);
+      return () => window.clearTimeout(t);
+    }
   }, [router]);

   const enter = (e: React.MouseEvent<HTMLAnchorElement>) => {
@@ -73,6 +83,7 @@ export default function Landing({ photo, years, recent }: LandingProps) {
     if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
     e.preventDefault();
     if (leaving) return;
+    preloadMap();
     // ?intro (for screen recordings) carries through to the map, which then plays its loader in full.
     const href = new URLSearchParams(window.location.search).has('intro') ? '/map?intro' : '/map';
     if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
diff --git a/src/app/components/MapWrapper.tsx b/src/app/components/MapWrapper.tsx
index 98b81f4..6b8b33b 100644
--- a/src/app/components/MapWrapper.tsx
+++ b/src/app/components/MapWrapper.tsx
@@ -5,9 +5,19 @@ import dynamic from 'next/dynamic';
 import SiteHeader from './SiteHeader';
 import Mark from './Mark';

+const loadMap = () => import('./Map');
+
+/**
+ * Fetches and runs the map's code (Mapbox included) ahead of time, so opening the map
+ * doesn't stall on it while the loader is up. Safe to call more than once.
+ */
+export function preloadMap() {
+    loadMap().catch(() => {});
+}
+
 // Mapbox needs the browser, so the map loads on the client. Until it does, the page
 // already has its header and the mark drawing itself where the map will be.
-const Map = dynamic(() => import('./Map'), {
+const Map = dynamic(loadMap, {
     ssr: false,
     loading: () => (
         <div className="mapshell">
diff --git a/src/app/components/Mark.tsx b/src/app/components/Mark.tsx
index 51409f1..0412738 100644
--- a/src/app/components/Mark.tsx
+++ b/src/app/components/Mark.tsx
@@ -1,6 +1,6 @@
 'use client';

-import { useEffect, useRef } from 'react';
+import { useEffect, useLayoutEffect, useRef } from 'react';

 import {
   CAMERA,
@@ -18,6 +18,17 @@ export function fireShutter() {
   window.dispatchEvent(new Event(SHUTTER_EVENT));
 }

+/**
+ * The map loader is mounted twice in a row: by MapWrapper while the map's code downloads,
+ * then by the map itself. A fresh element would restart its CSS animations, drawing the
+ * camera over again (or, with the main thread busy starting Mapbox, sitting on the first
+ * frame). So every loader reads one clock: the first sets it from how far its animations
+ * have run (they may have started from the server's HTML, before hydration), and each one
+ * after it jumps its animations to the same point. The clock clears once no loader is left.
+ */
+let loaderStart: number | null = null;
+let loadersMounted = 0;
+
 /**
  * The mark: a compact camera seen from the front, its lens a globe — photographs, mapped.
  *
@@ -45,6 +56,28 @@ export default function Mark({
   // The turning meridians keep their weight while squashed, so they're set in pixels.
   const arcPx = (sw * 0.85 * width) / VIEW.w;

+  useLayoutEffect(() => {
+    const svg = ref.current;
+    if (!detailed || !svg?.closest('.map-loader')) return;
+    loadersMounted++;
+    const anims = svg.getAnimations({ subtree: true });
+    const now = performance.now();
+    if (loaderStart === null) {
+      const ran = Math.max(0, ...anims.map((a) => Number(a.currentTime ?? 0)));
+      loaderStart = now - ran;
+    } else {
+      const t = now - loaderStart;
+      for (const a of anims) a.currentTime = t;
+    }
+    return () => {
+      loadersMounted--;
+      // The next loader mounts in the same commit, after this cleanup: wait for it.
+      setTimeout(() => {
+        if (loadersMounted === 0) loaderStart = null;
+      }, 0);
+    };
+  }, [detailed]);
+
   useEffect(() => {
     if (detailed) return;
     const svg = ref.current;
